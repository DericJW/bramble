rules_version = '2';

// Hedgerow keeps each person's farm under users/{their uid}. Only that signed-in person
// can read or write it; everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Accounts, programs, liabilities, pouches, entries and snapshots.
      match /{sub}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && sub in ['accounts', 'programs', 'liabilities', 'categories', 'entries', 'snapshots']
          && request.resource.data.size() < 40
          && (!('balance' in request.resource.data) || request.resource.data.balance is number)
          && (!('amount' in request.resource.data) || request.resource.data.amount is number);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
